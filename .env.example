# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Resend API Key for dispatching email transmissions.
# Replace re_xxxxxxxxx with your real API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxx"

# RESEND_FROM_EMAIL: Sender email address verified in Resend (defaults to onboarding@resend.dev for test domain)
RESEND_FROM_EMAIL="onboarding@resend.dev"

# SUPPORT_TO_EMAIL: Destination inbox for inquiries (defaults to cory.tortorici@globalintentcompany.space)
SUPPORT_TO_EMAIL="cory.tortorici@globalintentcompany.space"


# INTENT_API_URL: HTTPS origin for the Enhanced model gateway.
# Example: https://api.globalintentcompany.space
# Keep this server-side in Vercel; do not expose it through NEXT_PUBLIC_* variables.
INTENT_API_URL=""

# INTENT_API_KEY: Bearer token shared only by Vercel and the Enhanced gateway.
INTENT_API_KEY=""

# Optional independent Native endpoint. When configured, Native remains available
# even when the Enhanced gateway is offline. Both values are server-side only.
NATIVE_INTENT_API_URL=""
NATIVE_INTENT_API_KEY=""


# Supabase Auth / quota project. The publishable key is safe for browser use.
NEXT_PUBLIC_SUPABASE_URL="https://geksacqthxorbnrygxul.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Server-only Supabase key used for the inference quota RPC.
SUPABASE_SECRET_KEY=""


# CRON_KEEPALIVE_SECRET: Shared secret required by
# GET /api/cron/supabase-keepalive via the X-Cron-Secret request header.
# Generate a long random value and configure the same value in cron-job.org.
CRON_KEEPALIVE_SECRET=""


# PostHog web analytics. The project token is intentionally public in the browser.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="phc_REPLACE_ME"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
