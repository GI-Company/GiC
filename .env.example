# GEMINI_API_KEY: Server-only key for Gemini-backed LooseMouth and research agents.
# Set this in Vercel Environment Variables for Production and Preview (if used).
# Never prefix the secret with NEXT_PUBLIC_ or commit a real value.
GEMINI_API_KEY=""
# Optional Gemini mode overrides. Defaults used if these are unset.
GIC_GEMINI_FAST_MODEL="gemini-3.5-flash-lite"
GIC_GEMINI_MEDIUM_MODEL="gemini-3.8-flash"
GIC_GEMINI_ENHANCED_MODEL="gemini-3.1-pro-preview"
GIC_GEMINI_AGENT_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Resend API Key for dispatching email transmissions.
# Replace re_xxxxxxxxx with your real API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxx"

# RESEND_FROM_EMAIL: Sender email address verified in Resend (defaults to onboarding@resend.dev for test domain)
RESEND_FROM_EMAIL="onboarding@resend.dev"

# SUPPORT_TO_EMAIL: Destination inbox for inquiries (defaults to cory.tortorici@globalintentcompany.space)
SUPPORT_TO_EMAIL="cory.tortorici@globalintentcompany.space"


# INTENT_API_URL: HTTPS origin for the Enhanced model gateway.
# Example: https://api.globalintentcompany.space
# Keep this server-side in Vercel; do not expose it through NEXT_PUBLIC_* variables.
INTENT_API_URL=""

# INTENT_API_KEY: Bearer token shared only by Vercel and the Enhanced gateway.
INTENT_API_KEY=""

# Optional independent Native endpoint. When configured, Native remains available
# even when the Enhanced gateway is offline. Both values are server-side only.
NATIVE_INTENT_API_URL=""
NATIVE_INTENT_API_KEY=""


# Supabase Auth / quota project. The publishable key is safe for browser use.
NEXT_PUBLIC_SUPABASE_URL="https://geksacqthxorbnrygxul.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Server-only Supabase key used for the inference quota RPC.
SUPABASE_SECRET_KEY=""


# CRON_KEEPALIVE_SECRET: Shared secret required by
# GET /api/cron/supabase-keepalive via the X-Cron-Secret request header.
# Generate a long random value and configure the same value in cron-job.org.
CRON_KEEPALIVE_SECRET=""


# PostHog web analytics configuration. Read server-side and passed to the browser analytics SDK at runtime.
NEXT_POSTHOG_PROJECT_TOKEN="phc_REPLACE_ME"
NEXT_POSTHOG_HOST="https://us.i.posthog.com"


# Private hosted ResearchEngine reader. Disabled until a reviewed service exists.
VLAB_RESEARCH_READER_ENABLED=false
VLAB_RESEARCH_SERVICE_ORIGIN=
VLAB_RESEARCH_ISSUER=
VLAB_RESEARCH_AUDIENCE=
VLAB_RESEARCH_KEY_ID=
VLAB_RESEARCH_SIGNING_KEY=
