{
  "name": "VirtualLab public MCP rate observation",
  "description": "Log only above 600 POSTs per 60 seconds per IP per region. Review shared ChatGPT egress before enforcement.",
  "active": true,
  "conditionGroup": [
    {
      "conditions": [
        {
          "type": "path",
          "op": "eq",
          "value": "/api/virtual-lab/mcp"
        },
        {
          "type": "method",
          "op": "eq",
          "value": "POST"
        }
      ]
    }
  ],
  "action": {
    "mitigate": {
      "action": "rate_limit",
      "rateLimit": {
        "algo": "fixed_window",
        "window": 60,
        "limit": 600,
        "keys": [
          "ip"
        ],
        "action": "log"
      }
    }
  }
}
